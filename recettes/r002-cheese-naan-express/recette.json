 "etapes": [
  {
   "texte": "Mélanger la farine, la levure et une pincée de sel. Ajouter le yaourt et l'huile, pétrir jusqu'à obtenir une pâte souple (ajouter un peu d'eau si besoin)."
  },
  {
   "texte": "Laisser reposer la pâte sous un torchon.",
   "minuteur": 600
  },
  {
   "texte": "Diviser la pâte en 10 boules. Étaler chaque boule en disque fin."
  },
  {
   "texte": "Déposer 2 portions de fromage fondu au centre, refermer la pâte par-dessus et ré-étaler doucement."
  },
  {
   "texte": "Cuire chaque naan dans une poêle chaude sans matière grasse, à couvert, 2 à 3 min par face jusqu'à ce qu'il gonfle et dore.",
   "minuteur": 150
  },
  {
   "texte": "Faire fondre le beurre avec l'ail écrasé et en badigeonner les naans chauds."
  },
  {
   "texte": "Servir avec la salade assaisonnée."
  }
 ],
