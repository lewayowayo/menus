 "etapes": [
  {
   "texte": "Préchauffer le four à 200 °C. Éplucher et couper la butternut en cubes, mélanger avec 2 c. à s. d'huile, thym, sel, poivre, et rôtir.",
   "minuteur": 1800
  },
  {
   "texte": "Préparer 1,5 l de bouillon chaud et le garder frémissant."
  },
  {
   "texte": "Faire sauter les champignons émincés à la poêle, réserver.",
   "minuteur": 480
  },
  {
   "texte": "Dans une sauteuse, faire revenir l'oignon et l'ail émincés dans l'huile, ajouter le riz et le nacrer 2 min.",
   "minuteur": 180
  },
  {
   "texte": "Déglacer au vin blanc, puis ajouter le bouillon louche par louche en remuant, chaque louche absorbée avant la suivante.",
   "minuteur": 1080
  },
  {
   "texte": "Hors du feu, incorporer le beurre, le parmesan râpé et les champignons. Couvrir 2 min.",
   "minuteur": 120
  },
  {
   "texte": "Servir garni de butternut rôtie. Garder les restes : ils font les galettes de risotto (r039)."
  }
 ],
