 "etapes": [
  {
   "texte": "Dorer les cuisses de poulet dans l'huile d'olive sur toutes les faces, puis les réserver.",
   "minuteur": 600
  },
  {
   "texte": "Faire revenir les oignons émincés et l'ail avec le ras el hanout et la cannelle.",
   "minuteur": 180
  },
  {
   "texte": "Remettre le poulet, ajouter 40 cl d'eau et le bouillon cube, couvrir et laisser mijoter.",
   "minuteur": 900
  },
  {
   "texte": "Ajouter les carottes en tronçons, la butternut et les navets en gros cubes, les pruneaux et le miel."
  },
  {
   "texte": "Poursuivre la cuisson à couvert jusqu'à ce que les légumes soient tendres.",
   "minuteur": 1500
  },
  {
   "texte": "Faire griller les amandes à sec dans une poêle.",
   "minuteur": 180
  },
  {
   "texte": "Préparer la semoule : la couvrir du même volume d'eau bouillante salée avec un filet d'huile, laisser gonfler puis l'égrainer (quinoa à part pour Marie).",
   "minuteur": 300
  },
  {
   "texte": "Servir le tajine parsemé d'amandes et de coriandre ciselée, avec la semoule."
  }
 ],
