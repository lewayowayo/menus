 "etapes": [
  {
   "texte": "Préchauffer le four à 180 °C."
  },
  {
   "texte": "Faire tomber les épinards dans l'huile avec l'ail haché, puis bien les égoutter en pressant.",
   "minuteur": 300
  },
  {
   "texte": "Mélanger les épinards avec la ricotta, du sel, du poivre et une pincée de muscade."
  },
  {
   "texte": "Béchamel : délayer la maïzena dans un peu de lait froid. Chauffer le reste du lait avec le beurre, verser la maïzena et remuer jusqu'à épaississement. Saler, poivrer, muscade.",
   "minuteur": 420
  },
  {
   "texte": "Dans le plat, alterner une couche de béchamel, des plaques, la farce épinards-ricotta. Répéter trois fois."
  },
  {
   "texte": "Finir par la béchamel, le chèvre en rondelles et l'emmental."
  },
  {
   "texte": "Enfourner jusqu'à ce que le dessus soit gratiné.",
   "minuteur": 2100
  },
  {
   "texte": "Laisser reposer 5 minutes avant de couper.",
   "minuteur": 300
  }
 ],
