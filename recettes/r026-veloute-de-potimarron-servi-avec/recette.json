 "etapes": [
  {
   "texte": "Laver le potimarron (la peau se mange), l'épépiner et le couper en cubes. Émincer l'oignon."
  },
  {
   "texte": "Faire revenir l'oignon dans l'huile, ajouter le potimarron, couvrir d'eau avec le bouillon cube.",
   "minuteur": 120
  },
  {
   "texte": "Cuire jusqu'à ce que le potimarron soit tendre.",
   "minuteur": 1200
  },
  {
   "texte": "Pendant la cuisson, mélanger la farine, le yaourt, la levure et une pincée de sel pour obtenir une pâte souple. Diviser en 5 boules (la part de Marie avec la farine sans gluten, préparée en premier)."
  },
  {
   "texte": "Étaler chaque boule, déposer 2 portions de fromage fondu au centre, refermer et aplatir doucement."
  },
  {
   "texte": "Cuire les naans à sec dans une poêle chaude, à couvert, en les retournant.",
   "minuteur": 240
  },
  {
   "texte": "Mixer le velouté avec la crème, saler, poivrer, ajouter la muscade."
  },
  {
   "texte": "Servir le velouté bien chaud avec les naans."
  }
 ],
