 "etapes": [
  {
   "texte": "Utiliser idéalement du riz cuit la veille (sinon cuire le riz et le laisser refroidir étalé)."
  },
  {
   "texte": "Rassembler les restes du frigo : légumes cuits, poulet, jambon… et les couper en petits morceaux."
  },
  {
   "texte": "Faire revenir l'oignon émincé et l'ail dans l'huile au wok, à feu vif.",
   "minuteur": 180
  },
  {
   "texte": "Ajouter les restes et les petits pois, faire sauter.",
   "minuteur": 240
  },
  {
   "texte": "Ajouter le riz, bien séparer les grains et faire sauter jusqu'à ce qu'il soit chaud et légèrement doré, puis arroser de sauce soja.",
   "minuteur": 300
  },
  {
   "texte": "Pendant ce temps, cuire les œufs au plat dans une poêle.",
   "minuteur": 240
  },
  {
   "texte": "Servir le riz avec un œuf au plat par personne et la ciboulette ciselée."
  }
 ],
