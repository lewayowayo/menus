 "etapes": [
  {
   "texte": "Rincer le riz et le cuire dans 1,5 fois son volume d'eau salée, à couvert.",
   "minuteur": 720
  },
  {
   "texte": "Couper le poulet en lamelles. Le mélanger avec 2 c. à s. de sauce soja et la maïzena."
  },
  {
   "texte": "Émincer l'oignon, les carottes en bâtonnets, le poivron en lanières, le chou chinois en tronçons et les champignons en lamelles. Râper l'ail et le gingembre."
  },
  {
   "texte": "Faire sauter le poulet à feu vif dans 1 c. à s. d'huile jusqu'à ce qu'il soit doré, puis le réserver.",
   "minuteur": 300
  },
  {
   "texte": "Dans le même wok, faire sauter l'oignon, les carottes et le poivron avec le reste d'huile.",
   "minuteur": 240
  },
  {
   "texte": "Ajouter les champignons, l'ail, le gingembre puis le chou chinois, et cuire en remuant : les légumes doivent rester croquants.",
   "minuteur": 240
  },
  {
   "texte": "Remettre le poulet, ajouter le reste de sauce soja et 5 cl d'eau, mélanger 1 minute pour napper. Poivrer."
  },
  {
   "texte": "Servir avec le riz."
  }
 ],
