 "etapes": [
  {
   "texte": "Préchauffer le four à 200 °C."
  },
  {
   "texte": "Couper les tomates en rondelles, les saler et les laisser dégorger sur du papier absorbant.",
   "minuteur": 600
  },
  {
   "texte": "Foncer deux moules avec les pâtes, piquer le fond et étaler la moutarde."
  },
  {
   "texte": "Disposer les tomates en rosace, ajouter les herbes de Provence, poivrer et arroser d'un filet d'huile."
  },
  {
   "texte": "Enfourner jusqu'à ce que la pâte soit dorée.",
   "minuteur": 1800
  },
  {
   "texte": "À la sortie du four, laisser tiédir puis répartir la stracciatella et le basilic."
  },
  {
   "texte": "Servir avec la salade."
  }
