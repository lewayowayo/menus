 "etapes": [
  {
   "texte": "Rincer le riz et le cuire dans 1,5 fois son volume d'eau salée, à couvert.",
   "minuteur": 720
  },
  {
   "texte": "Couper le poulet en lamelles et le mélanger avec 2 c. à s. de sauce soja et la maïzena."
  },
  {
   "texte": "Couper les carottes en fins bâtonnets, le chou chinois en lanières, émincer l'oignon. Râper l'ail et le gingembre."
  },
  {
   "texte": "Saisir le poulet à feu vif dans 1 c. à s. d'huile neutre, puis le réserver.",
   "minuteur": 300
  },
  {
   "texte": "Faire sauter l'oignon et les carottes dans le reste d'huile.",
   "minuteur": 240
  },
  {
   "texte": "Ajouter l'ail, le gingembre et le chou chinois, et sauter à feu vif.",
   "minuteur": 180
  },
  {
   "texte": "Remettre le poulet, ajouter le reste de sauce soja et l'huile de sésame, mélanger 1 minute."
  },
  {
   "texte": "Servir sur le riz avec la coriandre ciselée."
  }
