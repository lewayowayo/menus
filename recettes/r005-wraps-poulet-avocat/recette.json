 "etapes": [
  {
   "texte": "Couper les blancs de poulet en lanières, les mélanger avec le paprika, le cumin, 1 c. à s. d'huile, sel et poivre."
  },
  {
   "texte": "Cuire le poulet dans une poêle chaude jusqu'à ce qu'il soit doré et cuit à cœur.",
   "minuteur": 480
  },
  {
   "texte": "Écraser les avocats avec le jus du citron vert, saler."
  },
  {
   "texte": "Couper les tomates en dés, émincer la salade, ciseler la coriandre."
  },
  {
   "texte": "Mélanger le yaourt avec un peu de sel, de poivre et de coriandre pour la sauce."
  },
  {
   "texte": "Réchauffer les tortillas quelques secondes à la poêle.",
   "minuteur": 30
  },
  {
   "texte": "Garnir chaque tortilla d'avocat, de poulet, de crudités et de sauce, puis rouler."
  }
