 "etapes": [
  {
   "texte": "Couper le poulet en morceaux (ou demander au boucher). Saler, poivrer."
  },
  {
   "texte": "Piler ou hacher finement l'ail et le gingembre avec une pincée de sel. Émincer les oignons, couper les tomates en dés."
  },
  {
   "texte": "Dans une cocotte en fonte, dorer les morceaux de poulet dans l'huile bien chaude sur toutes les faces.",
   "minuteur": 600
  },
  {
   "texte": "Ajouter les oignons et les laisser fondre 5 min.",
   "minuteur": 300
  },
  {
   "texte": "Ajouter le mélange ail-gingembre, le curcuma et le thym, remuer 1 min sans laisser brûler."
  },
  {
   "texte": "Ajouter les tomates, le piment selon le goût, couvrir et laisser mijoter 30 min à feu doux en remuant de temps en temps. Ajouter un fond d'eau si ça attache.",
   "minuteur": 1800
  },
  {
   "texte": "Cuire le riz.",
   "minuteur": 720
  },
  {
   "texte": "Découvrir et laisser réduire la sauce 5 min si besoin. Servir avec le riz blanc.",
   "minuteur": 300
  }
 ],
