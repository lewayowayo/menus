 "etapes": [
  {
   "texte": "Couper le poulet en lamelles et le mariner avec la sauce soja, 1 gousse d'ail hachée et 1 c. à s. de sucre pendant la préparation."
  },
  {
   "texte": "Sauce : mélanger le nuoc-mâm, le jus des citrons verts, 2 c. à s. de sucre, 1 gousse d'ail hachée et 12 cl d'eau. Goûter et ajuster."
  },
  {
   "texte": "Râper les carottes, couper le concombre en bâtonnets, émincer la salade, effeuiller menthe et coriandre."
  },
  {
   "texte": "Cuire les vermicelles de riz selon le paquet, les rincer à l'eau froide et bien égoutter.",
   "minuteur": 240
  },
  {
   "texte": "Concasser les cacahuètes et les torréfier 2 min à sec dans une poêle."
  },
  {
   "texte": "Émincer l'oignon, le faire dorer dans l'huile, puis ajouter le poulet et le dernier ail. Cuire 5 à 6 min à feu vif.",
   "minuteur": 360
  },
  {
   "texte": "Dans chaque bol : salade, vermicelles, crudités, poulet chaud, herbes, cacahuètes. Arroser de sauce au moment de manger."
  }
 ],
