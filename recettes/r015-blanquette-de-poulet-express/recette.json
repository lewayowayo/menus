 "etapes": [
  {
   "texte": "Couper le poulet en gros cubes, les carottes en rondelles, émincer l'oignon et les champignons."
  },
  {
   "texte": "Dans une cocotte, faire fondre le beurre et faire revenir le poulet et l'oignon 5 min sans trop colorer.",
   "minuteur": 300
  },
  {
   "texte": "Ajouter les carottes, couvrir avec 60 cl d'eau, ajouter le bouillon émietté, le thym et le laurier. Cuire 15 min à frémissement.",
   "minuteur": 900
  },
  {
   "texte": "Ajouter les champignons et cuire encore 5 min. Pendant ce temps, cuire le riz.",
   "minuteur": 300
  },
  {
   "texte": "Délayer la maïzena dans un peu d'eau froide, la verser dans la cocotte et laisser épaissir 2 min en remuant."
  },
  {
   "texte": "Hors du feu, mélanger la crème, le jaune d'œuf et le jus d'un demi-citron, puis verser dans la cocotte en remuant. Ne plus faire bouillir."
  },
  {
   "texte": "Rectifier l'assaisonnement et servir avec le riz."
  }
 ],
