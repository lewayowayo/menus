 "etapes": [
  {
   "texte": "Sortir les magrets 20 min avant. Quadriller la peau au couteau sans entailler la chair."
  },
  {
   "texte": "Cuire le riz selon le paquet.",
   "minuteur": 720
  },
  {
   "texte": "Éplucher les mangues et les couper en lamelles. Râper le gingembre."
  },
  {
   "texte": "Cuire les magrets côté peau dans une poêle froide puis à feu moyen 8 à 10 min, en retirant la graisse au fur et à mesure.",
   "minuteur": 540
  },
  {
   "texte": "Retourner et cuire 3 à 4 min côté chair pour une cuisson rosée.",
   "minuteur": 210
  },
  {
   "texte": "Laisser reposer les magrets 5 min sous aluminium.",
   "minuteur": 300
  },
  {
   "texte": "Vider la poêle en gardant 1 c. à s. de graisse, ajouter miel, vinaigre, soja et gingembre, puis les mangues. Faire caraméliser 3 min.",
   "minuteur": 180
  },
  {
   "texte": "Trancher les magrets, napper de sauce aux mangues et servir avec le riz."
  }
 ],
