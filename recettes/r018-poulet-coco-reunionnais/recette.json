 "etapes": [
  {
   "texte": "Couper le poulet en morceaux, saler, poivrer."
  },
  {
   "texte": "Hacher l'ail et le gingembre, émincer les oignons, couper les tomates en dés."
  },
  {
   "texte": "Dorer le poulet dans l'huile dans une cocotte.",
   "minuteur": 600
  },
  {
   "texte": "Ajouter oignons, ail, gingembre, curcuma et thym, faire revenir 3 min.",
   "minuteur": 180
  },
  {
   "texte": "Ajouter les tomates puis le lait de coco et le piment. Couvrir et mijoter 30 min à feu doux.",
   "minuteur": 1800
  },
  {
   "texte": "Cuire le riz.",
   "minuteur": 720
  },
  {
   "texte": "Ajouter le jus du citron vert en fin de cuisson, rectifier l'assaisonnement et servir avec le riz."
  }
