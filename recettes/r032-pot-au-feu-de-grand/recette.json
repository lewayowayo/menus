 "etapes": [
  {
   "texte": "À lancer la veille de préférence (4 à 5 h de cuisson au total) : la viande est meilleure réchauffée doucement dans son bouillon, et on dégraisse facilement une fois refroidi."
  },
  {
   "texte": "Mettre les viandes dans une grande cocotte, couvrir d'eau froide, porter à ébullition et écumer.",
   "minuteur": 900
  },
  {
   "texte": "Ajouter les oignons piqués des clous de girofle, le laurier, le thym, sel et poivre. Laisser frémir à couvert, à tout petit feu, environ 3 h 30.",
   "minuteur": 12600
  },
  {
   "texte": "Pendant ce temps, éplucher carottes, navets, céleri, pommes de terre ; nettoyer les poireaux et les ficeler ; couper le chou en quartiers."
  },
  {
   "texte": "Ajouter carottes, poireaux, navets et céleri dans la cocotte.",
   "minuteur": 1800
  },
  {
   "texte": "Ajouter le chou, les pommes de terre et les os à moelle (bouts salés).",
   "minuteur": 1800
  },
  {
   "texte": "Vérifier la cuisson des légumes à la pointe du couteau."
  },
  {
   "texte": "Servir la viande tranchée avec les légumes, un bol de bouillon, moutarde, cornichons et gros sel."
  }
