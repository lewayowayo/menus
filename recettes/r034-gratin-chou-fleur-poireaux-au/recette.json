 "etapes": [
  {
   "texte": "Préchauffer le four à 200 °C. Détailler le chou-fleur en bouquets et le cuire à l'eau salée ou à la vapeur.",
   "minuteur": 600
  },
  {
   "texte": "Émincer les poireaux et les faire fondre dans une noix de beurre à feu doux.",
   "minuteur": 600
  },
  {
   "texte": "Béchamel : délayer la maïzena dans un peu de lait froid. Chauffer le reste du lait avec le beurre, ajouter la maïzena et fouetter jusqu'à épaississement. Sel, poivre, muscade, la moitié du comté.",
   "minuteur": 300
  },
  {
   "texte": "Couper le jambon en lanières."
  },
  {
   "texte": "Dans un plat beurré, mélanger chou-fleur, poireaux et jambon, napper de béchamel et parsemer du reste de comté."
  },
  {
   "texte": "Gratiner au four.",
   "minuteur": 1500
  },
  {
   "texte": "Pendant ce temps, cuire le riz pour l'accompagnement.",
