 "etapes": [
  {
   "texte": "Hacher les herbes, un oignon et l'ail."
  },
  {
   "texte": "Mélanger le bœuf haché avec l'œuf, la moitié des herbes, l'oignon haché, la moitié de l'ail, le cumin, la cannelle, sel et poivre. Former des boulettes de la taille d'une noix."
  },
  {
   "texte": "Dorer les boulettes dans l'huile d'olive au fond d'un tajine ou d'une cocotte. Réserver.",
   "minuteur": 420
  },
  {
   "texte": "Émincer le second oignon et le faire fondre avec le reste de l'ail, le paprika et le ras el hanout.",
   "minuteur": 300
  },
  {
   "texte": "Ajouter la tomate concassée et 20 cl d'eau, puis les petits pois et les boulettes. Couvrir et mijoter 20 min.",
   "minuteur": 1200
  },
  {
   "texte": "Préparer la semoule : la couvrir du même volume d'eau bouillante salée avec un filet d'huile, couvrir 5 min puis égrainer.",
   "minuteur": 300
  },
  {
   "texte": "Parsemer le tajine du reste des herbes et servir avec la semoule."
  }
 ],
