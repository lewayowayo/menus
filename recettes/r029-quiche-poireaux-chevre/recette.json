 "etapes": [
  {
   "texte": "Préchauffer le four à 180 °C."
  },
  {
   "texte": "Laver les poireaux et les émincer finement (blanc et un peu de vert)."
  },
  {
   "texte": "Faire fondre les poireaux dans le beurre à feu doux, à couvert.",
   "minuteur": 900
  },
  {
   "texte": "Foncer deux moules avec les pâtes et les piquer à la fourchette."
  },
  {
   "texte": "Battre les œufs avec la crème, le lait, du sel, du poivre et la muscade."
  },
  {
   "texte": "Répartir les poireaux sur les fonds, ajouter le chèvre en rondelles, verser l'appareil et parsemer d'emmental."
