 "etapes": [
  {
   "texte": "Préchauffer le four à 200 °C."
  },
  {
   "texte": "Beurrer légèrement les tranches de pain de mie sur une face."
  },
  {
   "texte": "Sur 10 tranches (face beurrée dessous), étaler un peu de crème, poser une tranche de jambon et un peu d'emmental."
  },
  {
   "texte": "Refermer avec les 10 autres tranches, face beurrée dessus."
  },
  {
   "texte": "Napper le dessus d'un peu de crème, parsemer du reste d'emmental et poivrer."
  },
  {
   "texte": "Enfourner jusqu'à ce que le dessus soit doré.",
