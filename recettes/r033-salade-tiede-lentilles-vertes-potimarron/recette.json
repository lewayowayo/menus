 "etapes": [
  {
   "texte": "Préchauffer le four à 200 °C. Couper le potimarron en cubes (sans l'éplucher), mélanger avec 2 c. à s. d'huile, le cumin, sel et poivre."
  },
  {
   "texte": "Rôtir le potimarron en remuant à mi-cuisson.",
   "minuteur": 1800
  },
  {
   "texte": "Rincer les lentilles, les cuire dans 3 fois leur volume d'eau froide avec le laurier, sans saler.",
   "minuteur": 1500
  },
  {
   "texte": "Préparer la vinaigrette : moutarde, vinaigre, 4 c. à s. d'huile, sel, poivre. Émincer finement l'oignon rouge."
  },
  {
   "texte": "Cuire les œufs mollets : 6 min dans l'eau bouillante, puis eau froide et écaler.",
   "minuteur": 360
  },
  {
   "texte": "Égoutter les lentilles, saler et mélanger tièdes avec la vinaigrette et l'oignon."
  },
  {
   "texte": "Dresser : mâche, lentilles, potimarron, feta émiettée, persil ciselé et un œuf mollet coupé en deux par assiette."
  }
 ],
