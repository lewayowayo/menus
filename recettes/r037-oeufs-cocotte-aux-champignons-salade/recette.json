 "etapes": [
  {
   "texte": "Préchauffer le four à 180 °C. Émincer les champignons et l'échalote, les faire sauter au beurre jusqu'à évaporation de l'eau. Saler, poivrer.",
   "minuteur": 480
  },
  {
   "texte": "Répartir les champignons dans 10 ramequins beurrés, ajouter une cuillère de crème puis casser un œuf dans chacun."
  },
  {
   "texte": "Parsemer d'emmental et de ciboulette, poser les ramequins dans un plat avec de l'eau chaude (bain-marie)."
  },
  {
   "texte": "Cuire au four : le blanc doit être pris, le jaune coulant.",
   "minuteur": 720
  },
  {
   "texte": "Pendant ce temps, émincer les endives, couper les pommes en dés, concasser les noix."
  },
  {
   "texte": "Vinaigrette moutarde, vinaigre, huile ; mélanger avec la salade au dernier moment."
  },
  {
   "texte": "Griller le pain pour les mouillettes et servir aussitôt."
  }
 ],
