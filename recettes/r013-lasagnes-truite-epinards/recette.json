 "etapes": [
  {
   "texte": "Préchauffer le four à 180 °C."
  },
  {
   "texte": "Laver les épinards et les faire tomber 3 à 4 min dans une grande sauteuse avec l'huile et l'ail émincé. Égoutter en pressant bien.",
   "minuteur": 240
  },
  {
   "texte": "Retirer la peau de la truite et la couper en dés. Arroser d'un filet de jus de citron, saler, poivrer."
  },
  {
   "texte": "Béchamel : délayer la maïzena dans un peu de lait froid. Faire chauffer le reste du lait avec le beurre, ajouter la maïzena et fouetter sur feu moyen jusqu'à épaississement. Saler, poivrer, muscader.",
   "minuteur": 300
  },
  {
   "texte": "Mélanger les épinards avec la ricotta."
  },
  {
   "texte": "Dans un grand plat beurré : un peu de béchamel, des plaques, épinards-ricotta, truite, béchamel. Recommencer et finir par plaques et béchamel."
  },
  {
   "texte": "Parsemer d'emmental et cuire 35 à 40 min, jusqu'à ce que le dessus soit doré.",
   "minuteur": 2400
  },
  {
   "texte": "Laisser reposer 5 min avant de servir.",
   "minuteur": 300
  }
 ],
